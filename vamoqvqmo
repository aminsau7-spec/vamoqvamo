                    challenge: 'Elevar a percepção de valor da marca e otimizar o checkout mobile que representava 82% dos acessos.',
                    result: 'Aumento de 68% na taxa de conversão e crescimento de 2.4x no ticket médio.',
                    tags: ['E-commerce', 'Branding', 'SEO Técnico', 'CRO']
                },
                {
                    id: 3,
                    title: 'Veloce Mobilidade',
                    category: 'Plataforma SaaS',
                    client: 'Veloce Smart Urban',
                    year: '2026',
                    gradient: 'from-violet-600 via-purple-600 to-fuchsia-500',
                    summary: 'Sistema web de monitoramento de frotas elétricas e reservas corporativas com mapas interativos.',
                    challenge: 'Exibir milhares de pontos de telemetria em tempo real sem comprometer a fluidez no navegador.',
                    result: 'Operação ativa em 14 capitais com 99.98% de disponibilidade e satisfação 4.9/5.',
                    tags: ['Web App', 'Geolocalização', 'Performance', 'Full-Stack']
                }
            ];

            const portfolioGrid = document.getElementById('portfolio-grid');
            const portfolioModal = document.getElementById('portfolio-modal');
            const modalContent = document.getElementById('modal-content');
            const closeModalBtn = document.getElementById('close-modal-btn');

            portfolioGrid.innerHTML = portfolioData.map(project => `
                <article class="group rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
                    <!-- Banner Visual em Gradiente com Ilustração Geométrica -->
                    <div class="relative h-56 bg-gradient-to-br ${project.gradient} p-6 flex flex-col justify-between overflow-hidden">
                        <div class="absolute -right-8 -bottom-8 w-40 h-40 rounded-full bg-white/15 blur-xl group-hover:scale-125 transition-transform duration-500"></div>
                        <span class="self-start px-3 py-1 rounded-full bg-black/25 backdrop-blur-md text-white text-xs font-semibold">
                            ${project.category}
                        </span>
                        <div class="text-white">
                            <p class="text-xs uppercase tracking-wider opacity-80">${project.client}</p>
                            <h3 class="text-2xl font-extrabold mt-0.5">${project.title}</h3>
                        </div>
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">${project.summary}</p>
                            <div class="mt-4 flex flex-wrap gap-2">
                                ${project.tags.map(tag => `<span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">${tag}</span>`).join('')}
                            </div>
                        </div>

                        <button data-project-id="${project.id}" class="open-project-btn mt-6 w-full py-3 px-4 rounded-xl bg-slate-100 hover:bg-brand-600 dark:bg-slate-800 dark:hover:bg-brand-600 text-slate-800 hover:text-white dark:text-slate-200 font-semibold text-sm transition-colors flex items-center justify-center gap-2">
                            Ver Detalhes do Case
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        </button>
                    </div>
                </article>
            `).join('');

            function openProjectModal(projectId) {
                const project = portfolioData.find(p => p.id === Number(projectId));
                if (!project) return;

                modalContent.innerHTML = `
                    <div class="h-44 bg-gradient-to-r ${project.gradient} p-8 flex flex-col justify-end text-white">
                        <span class="text-xs font-bold uppercase tracking-wider opacity-85">${project.category} • ${project.year}</span>
                        <h3 class="text-3xl font-extrabold mt-1">${project.title}</h3>
                    </div>
                    <div class="p-6 sm:p-8 space-y-5">
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Cliente</h4>
                            <p class="font-semibold text-slate-900 dark:text-white">${project.client}</p>
                        </div>
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">O Desafio</h4>
                            <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">${project.challenge}</p>
                        </div>
                        <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Resultados Alcançados</h4>
                            <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-200 mt-1">${project.result}</p>
                        </div>
                        <div class="flex flex-wrap gap-2 pt-2">
                            ${project.tags.map(tag => `<span class="text-xs font-semibold px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300">${tag}</span>`).join('')}
                        </div>
                    </div>
                `;

                portfolioModal.classList.remove('hidden');
                portfolioModal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeProjectModal() {
                portfolioModal.classList.add('hidden');
                portfolioModal.classList.remove('flex');
                document.body.style.overflow = '';
            }

            document.querySelectorAll('.open-project-btn').forEach(btn => {
                btn.addEventListener('click', () => openProjectModal(btn.getAttribute('data-project-id')));
            });

            closeModalBtn.addEventListener('click', closeProjectModal);
            portfolioModal.addEventListener('click', (e) => {
                if (e.target === portfolioModal) closeProjectModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !portfolioModal.classList.contains('hidden')) closeProjectModal();
            });

            /* ----------------------------------------------------------------
               5. CALCULADORA INTERATIVA DE ORÇAMENTO
            ---------------------------------------------------------------- */
            const projectRadios = document.querySelectorAll('input[name="projectType"]');
            const pagesSlider = document.getElementById('pages-slider');
            const pagesDisplay = document.getElementById('pages-display');
            const addonCheckboxes = document.querySelectorAll('.addon-checkbox');
            const totalPriceEl = document.getElementById('total-price');
            const estimatedDaysEl = document.getElementById('estimated-days');
            const quoteBreakdownEl = document.getElementById('quote-breakdown');
            const applyQuoteBtn = document.getElementById('apply-quote-btn');

            let currentQuoteSummary = '';

            function formatBRL(value) {
                return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }

            function calculateQuote() {
                const selectedType = document.querySelector('input[name="projectType"]:checked');
                const basePrice = Number(selectedType.getAttribute('data-price'));
                const baseDays = Number(selectedType.getAttribute('data-days'));
                const typeLabels = {
                    landing: 'Landing Page Estratégica',
                    institucional: 'Site Corporativo Completo',
                    webapp: 'Sistema / Web App Sob Medida'
                };
                const typeName = typeLabels[selectedType.value];

                const pages = Number(pagesSlider.value);
                pagesDisplay.textContent = pages === 1 ? '1 página' : `${pages} páginas`;

                // Primeira página já inclusa no valor base; cada página extra custa R$ 250
                const extraPages = Math.max(0, pages - 1);
                const pagesCost = extraPages * 250;
                const pagesDays = Math.ceil(extraPages * 0.6);

                let addonsCost = 0;
                let addonsDays = 0;
                const selectedAddons = [];

                addonCheckboxes.forEach(cb => {
                    if (cb.checked) {
                        const price = Number(cb.getAttribute('data-price'));
                        const days = Number(cb.getAttribute('data-days'));
                        const name = cb.getAttribute('data-name');
                        addonsCost += price;
                        addonsDays += days;
                        selectedAddons.push({ name, price });
                    }
                });

                const total = basePrice + pagesCost + addonsCost;
                const totalDays = baseDays + pagesDays + addonsDays;

                totalPriceEl.textContent = formatBRL(total);
                estimatedDaysEl.textContent = `${totalDays} dias úteis`;

                // Renderiza detalhamento
                let breakdownHTML = `
                    <div class="flex justify-between">
                        <span>${typeName}</span>
                        <span class="font-semibold text-white">${formatBRL(basePrice)}</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Estrutura (${pages} ${pages === 1 ? 'página' : 'páginas'})</span>
                        <span class="font-semibold text-white">${pagesCost > 0 ? '+' + formatBRL(pagesCost) : 'Incluso'}</span>
                    </div>
                `;

                selectedAddons.forEach(addon => {
                    breakdownHTML += `
                        <div class="flex justify-between text-brand-300">
                            <span>+ ${addon.name}</span>
                            <span class="font-semibold">+${formatBRL(addon.price)}</span>
                        </div>
                    `;
                });

                quoteBreakdownEl.innerHTML = breakdownHTML;

                // Guarda resumo para preencher automaticamente o formulário de contato
                const addonsText = selectedAddons.length > 0 
                    ? selectedAddons.map(a => a.name).join(', ') 
                    : 'Nenhum adicional';
                currentQuoteSummary = `Olá, NovaWeb! Fiz uma simulação no site:\n• Projeto: ${typeName}\n• Escopo: ${pages} página(s)\n• Extras: ${addonsText}\n• Estimativa: ${formatBRL(total)} (${totalDays} dias úteis)\n\nGostaria de agendar uma reunião para avançarmos!`;
            }

            projectRadios.forEach(r => r.addEventListener('change', calculateQuote));
            pagesSlider.addEventListener('input', calculateQuote);
            addonCheckboxes.forEach(cb => cb.addEventListener('change', calculateQuote));

            // Botão que transfere o orçamento simulado para o formulário de contato
            applyQuoteBtn.addEventListener('click', () => {
                const subjectInput = document.getElementById('subject');
                const messageInput = document.getElementById('message');
                subjectInput.value = 'Proposta de Orçamento Simulado';
                messageInput.value = currentQuoteSummary;

                // Dispara validação visual nos campos preenchidos
                validateField(subjectInput, document.getElementById('error-subject'), val => val.trim().length >= 3);
                validateField(messageInput, document.getElementById('error-message'), val => val.trim().length >= 15);

                document.getElementById('contato').scrollIntoView({ behavior: 'smooth' });
                document.getElementById('name').focus();
            });

            calculateQuote();

            /* ----------------------------------------------------------------
               6. VALIDAÇÃO DE FORMULÁRIO EM TEMPO REAL E ENVIO
            ---------------------------------------------------------------- */
            const contactForm = document.getElementById('contact-form');
            const nameInput = document.getElementById('name');
            const emailInput = document.getElementById('email');
            const subjectInput = document.getElementById('subject');
            const messageInput = document.getElementById('message');
            const successBanner = document.getElementById('form-success-banner');

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            function validateField(inputEl, errorEl, validatorFn) {
                const isValid = validatorFn(inputEl.value);
                if (!isValid) {
                    inputEl.classList.add('border-rose-500', 'focus:ring-rose-500');
                    inputEl.classList.remove('border-slate-300', 'dark:border-slate-700', 'border-emerald-500');
                    errorEl.classList.remove('hidden');
                } else {
                    inputEl.classList.remove('border-rose-500', 'focus:ring-rose-500');
                    inputEl.classList.add('border-emerald-500');
                    errorEl.classList.add('hidden');
                }
                return isValid;
            }

            nameInput.addEventListener('input', () => validateField(nameInput, document.getElementById('error-name'), v => v.trim().length >= 3));
            emailInput.addEventListener('input', () => validateField(emailInput, document.getElementById('error-email'), v => emailRegex.test(v.trim())));
            subjectInput.addEventListener('input', () => validateField(subjectInput, document.getElementById('error-subject'), v => v.trim().length >= 3));
            messageInput.addEventListener('input', () => validateField(messageInput, document.getElementById('error-message'), v => v.trim().length >= 15));

            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();

                const isNameValid = validateField(nameInput, document.getElementById('error-name'), v => v.trim().length >= 3);
                const isEmailValid = validateField(emailInput, document.getElementById('error-email'), v => emailRegex.test(v.trim()));
                const isSubjectValid = validateField(subjectInput, document.getElementById('error-subject'), v => v.trim().length >= 3);
                const isMessageValid = validateField(messageInput, document.getElementById('error-message'), v => v.trim().length >= 15);

                if (isNameValid && isEmailValid && isSubjectValid && isMessageValid) {
                    const submitBtn = document.getElementById('submit-btn');
                    const originalHTML = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Enviando...`;

                    setTimeout(() => {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalHTML;
                        contactForm.reset();
                        [nameInput, emailInput, subjectInput, messageInput].forEach(el => el.classList.remove('border-emerald-500'));
                        successBanner.classList.remove('hidden');

                        setTimeout(() => {
                            successBanner.classList.add('hidden');
                        }, 6000);
                    }, 900);
                }
            });

            /* ----------------------------------------------------------------
               7. BOTÃO VOLTAR AO TOPO
            ---------------------------------------------------------------- */
            const backToTopBtn = document.getElementById('back-to-top');

            window.addEventListener('scroll', () => {
                if (window.scrollY > 450) {
                    backToTopBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
                    backToTopBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
                } else {
                    backToTopBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
                    backToTopBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                }
            });

            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    </script>
</body>
</html>
