                    <div>
                        <label class="block text-base font-bold text-slate-900 dark:text-white mb-4">1. Qual o tipo de projeto?</label>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="project-type-options">
                            <label class="cursor-pointer">
                                <input type="radio" name="projectType" value="landing" data-price="1800" data-days="7" class="peer sr-only" checked>
