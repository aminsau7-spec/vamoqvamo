    </header>

    <!-- ==================== 2. SEÇÃO HERO ==================== -->
    <section id="inicio" class="relative pt-32 pb-20 lg:pt-44 lg:pb-28 overflow-hidden">
        <!-- Elementos decorativos de fundo -->
