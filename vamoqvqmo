                                    <div class="font-semibold text-sm text-slate-900 dark:text-white">SEO Avançado</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">Otimização Google & Core Web Vitals (+R$ 900)</div>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 cursor-pointer transition-colors">
                                <input type="checkbox" class="addon-checkbox mt-1 w-4 h-4 rounded text-brand-600 focus:ring-brand-500" data-name="Integração E-commerce" data-price="2200" data-days="7">
                                <div>
                                    <div class="font-semibold text-sm text-slate-900 dark:text-white">E-commerce & Pagamentos</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">Checkout Pix/Cartão e catálogo (+R$ 2.200)</div>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 cursor-pointer transition-colors">
                                <input type="checkbox" class="addon-checkbox mt-1 w-4 h-4 rounded text-brand-600 focus:ring-brand-500" data-name="Blog / CMS Gerenciável" data-price="750" data-days="2">
                                <div>
                                    <div class="font-semibold text-sm text-slate-900 dark:text-white">Blog & Painel CMS</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">Publique artigos facilmente (+R$ 750)</div>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 cursor-pointer transition-colors">
                                <input type="checkbox" class="addon-checkbox mt-1 w-4 h-4 rounded text-brand-600 focus:ring-brand-500" data-name="Plano de Manutenção (3 meses)" data-price="1100" data-days="0">
