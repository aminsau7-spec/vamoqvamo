                    </div>

                    <!-- 3. Recursos Extras -->
                    <div>
                        <label class="block text-base font-bold text-slate-900 dark:text-white mb-4">3. Recursos e Módulos Adicionais</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
