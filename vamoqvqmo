                                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Foco em conversão</div>
                                    <div class="text-sm font-semibold text-brand-600 dark:text-brand-400 mt-2">R$ 1.800 base</div>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="projectType" value="institucional" data-price="3500" data-days="15" class="peer sr-only">
                                <div class="p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-900/20 transition-all">
                                    <div class="font-bold text-slate-900 dark:text-white">Site Corporativo</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Autoridade e marca</div>
                                    <div class="text-sm font-semibold text-brand-600 dark:text-brand-400 mt-2">R$ 3.500 base</div>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="projectType" value="webapp" data-price="6500" data-days="25" class="peer sr-only">
                                <div class="p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-900/20 transition-all">
                                    <div class="font-bold text-slate-900 dark:text-white">Sistema / Web App</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Sob medida</div>
                                    <div class="text-sm font-semibold text-brand-600 dark:text-brand-400 mt-2">R$ 6.500 base</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- 2. Número de Páginas -->
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <label for="pages-slider" class="text-base font-bold text-slate-900 dark:text-white">2. Quantidade de Páginas / Telas</label>
                            <span id="pages-display" class="px-3 py-1 rounded-lg bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 font-bold text-sm">5 páginas</span>
                        </div>
                        <input id="pages-slider" type="range" min="1" max="20" value="5" class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-brand-600">
                        <div class="flex justify-between text-xs text-slate-400 mt-2">
                            <span>1 página</span>
                            <span>10 páginas</span>
                            <span>20 páginas</span>
